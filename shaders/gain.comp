// gain.comp - Brightness gain compute shader (multi-format)
//
// Compile with IMAGE_FORMAT define for each bit depth:
//   glslc -DIMAGE_FORMAT=rgba8   gain.comp -o gain_8.spv      (8-bit)
//   glslc -DIMAGE_FORMAT=rgba16  gain.comp -o gain_16.spv     (16-bit)
//   glslc -DIMAGE_FORMAT=rgba32f gain.comp -o gain_float.spv  (32-bit float)
//
// Default compiles as rgba8 (8-bit).

#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// IMAGE_FORMAT is defined via -D at compile time
// Default to rgba8 if not specified
#ifndef IMAGE_FORMAT
#define IMAGE_FORMAT rgba8
#endif

layout(binding = 0, IMAGE_FORMAT) uniform readonly  image2D inputImage;
layout(binding = 1, IMAGE_FORMAT) uniform writeonly image2D outputImage;

layout(std140, binding = 2) uniform Params {
    int   width;
    int   height;
    float gain;     // 0-100 range
    float _padding;
};

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    // Bounds check (workgroups may exceed image dimensions)
    if (coord.x >= width || coord.y >= height) {
        return;
    }

    // Read input pixel
    vec4 pixel = imageLoad(inputImage, coord);

    // Apply gain: add brightness proportionally (gain/100 maps to 0-1 range)
    float g = gain / 100.0;

    vec4 result;
    result.r = pixel.r + g;
    result.g = pixel.g + g;
    result.b = pixel.b + g;
    result.a = pixel.a;  // Preserve alpha

    // Write output pixel
    // (UNORM formats auto-clamp to 0-1; SFLOAT allows HDR values)
    imageStore(outputImage, coord, result);
}
