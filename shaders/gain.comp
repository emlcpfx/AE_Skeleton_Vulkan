// gain.comp - Simple brightness gain compute shader
//
// This is the GPU equivalent of the CPU GainFunc8/GainFunc16 functions.
// Each thread processes one pixel: reads RGBA, adds gain, writes output.
//
// To compile to SPIR-V:
//   glslc gain.comp -o gain.spv
//
// To embed as C++ header:
//   xxd -i gain.spv > ../src/gpu/gain_shader_spv.h
//
// Or on Windows (PowerShell):
//   See compile_shader.bat in this directory

#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Input and output images (storage images for compute shader access)
layout(binding = 0, rgba8) uniform readonly  image2D inputImage;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// Parameters
layout(std140, binding = 2) uniform Params {
    int   width;
    int   height;
    float gain;     // 0-100 range
    float _padding;
};

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    // Bounds check (workgroups may exceed image dimensions)
    if (coord.x >= width || coord.y >= height) {
        return;
    }

    // Read input pixel
    vec4 pixel = imageLoad(inputImage, coord);

    // Apply gain: add brightness proportionally (gain/100 maps to 0-1 range)
    float g = gain / 100.0;

    vec4 result;
    result.r = clamp(pixel.r + g, 0.0, 1.0);
    result.g = clamp(pixel.g + g, 0.0, 1.0);
    result.b = clamp(pixel.b + g, 0.0, 1.0);
    result.a = pixel.a;  // Preserve alpha

    // Write output pixel
    imageStore(outputImage, coord, result);
}
